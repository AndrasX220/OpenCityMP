; OpenCityMP - Godot 4.7.2 .NET
; Procedural low-poly prototype. No GTA assets are included.
config_version=5

[application]

config/name="OpenCityMP"
config/description="Open-world multiplayer platform prototype"
run/main_scene="res://Scenes/Main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="OpenCityMP"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
environment/defaults/default_clear_color=Color(0.10, 0.20, 0.28, 1)
